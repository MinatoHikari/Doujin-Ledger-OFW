---
import { SITE, OPEN_GRAPH, SIDEBAR } from "../config";
import { formatUrl } from "../utils/tools";
import { getPageMeta } from "../utils/seo";

export interface Props {
  content: any;
  site: any;
  canonicalURL: URL | string;
}
const { content = {}, canonicalURL } = Astro.props;

const effectiveCanonicalURL = canonicalURL || Astro.url;
const currentUrl =
  typeof effectiveCanonicalURL === "string"
    ? new URL(effectiveCanonicalURL)
    : effectiveCanonicalURL;
const currentPath = formatUrl(currentUrl.pathname || "/") || "/";
const siteUrl = Astro.site?.href || currentUrl.origin;
const canonicalHref =
  typeof effectiveCanonicalURL === "string"
    ? effectiveCanonicalURL
    : effectiveCanonicalURL.toString();

const { pageTitle, documentTitle, description, isHome } = getPageMeta(
  currentPath,
  content
);

const imageSrc = content?.image?.src ?? OPEN_GRAPH.image.src;
const canonicalImageSrc = new URL(imageSrc, Astro.site).toString();
const imageAlt = content?.image?.alt ?? OPEN_GRAPH.image.alt;
const imageWidth = content?.image?.width ?? OPEN_GRAPH.image.width;
const imageHeight = content?.image?.height ?? OPEN_GRAPH.image.height;
const imageType = content?.image?.type ?? OPEN_GRAPH.image.type;

let breadcrumbItems = [
  {
    "@type": "ListItem",
    position: 1,
    name: SITE.title,
    item: siteUrl,
  },
];

if (!isHome) {
  const currentIndex = SIDEBAR.findIndex(
    (item) => item.link && formatUrl(item.link) === currentPath
  );

  if (currentIndex !== -1) {
    const currentItem = SIDEBAR[currentIndex];
    for (let i = currentIndex; i >= 0; i--) {
      if (SIDEBAR[i].header) {
        breadcrumbItems.push({
          "@type": "ListItem",
          position: breadcrumbItems.length + 1,
          name: SIDEBAR[i].text,
          item: siteUrl,
        });
        break;
      }
    }

    breadcrumbItems.push({
      "@type": "ListItem",
      position: breadcrumbItems.length + 1,
      name: currentItem.text,
      item: canonicalHref,
    });
  }
}

const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: siteUrl,
};

const softwareSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: SITE.title,
      description: SITE.description,
      applicationCategory: "FinanceApplication",
      operatingSystem: "Android",
      url: siteUrl,
      image: canonicalImageSrc,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "CNY",
      },
    }
  : null;

const webPageSchema = !isHome
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      name: pageTitle,
      description,
      url: canonicalHref,
      isPartOf: {
        "@type": "WebSite",
        name: SITE.title,
        url: siteUrl,
      },
    }
  : null;
---

<title>{documentTitle}</title>

<!-- Page Metadata -->
<link rel="canonical" href={canonicalHref} />

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<meta name="author" content={SITE.title} />
<meta name="theme-color" content="#1e293b" />

<!-- WeChat / QQ share card helpers -->
<meta itemprop="name" content={documentTitle} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={canonicalImageSrc} />

<!-- Apple Mobile Web App -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content={SITE.title} />

<!-- OpenGraph Tags -->
<meta property="og:title" content={documentTitle} />
<meta property="og:type" content={isHome ? "website" : "article"} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:locale" content={content.ogLocale ?? SITE.defaultLanguage} />
<meta property="og:image" content={canonicalImageSrc} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE.title} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{softwareSchema && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema)}
  />
)}
{breadcrumbItems.length > 1 && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbList)}
  />
)}
{webPageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
)}
