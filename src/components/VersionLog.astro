---
import { versionLogs } from "../config/versionLog";
---

<div class="not-prose">
  {versionLogs.map((log) => (
    <div class="mb-8 pb-6 border-b border-slate-200 last:mb-0 last:border-0 last:pb-0">
      <h3 class="text-xl font-semibold mb-3">
        v{log.version}
        {log.date && (
          <span class="ml-2 text-sm font-normal text-slate-400">
            ({log.date})
          </span>
        )}
      </h3>
      <ul class="list-decimal list-outside pl-6 space-y-2 leading-relaxed text-slate-700 break-words marker:font-medium marker:text-slate-400">
        {log.changes.map((change) => (
          <li>{change}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
